import sailpoint.object.*;
import java.util.*;

Identity idn = context.getObjectByName(Identity.class, "PUT_YOUR_IDENTITY_NAME");

String apps = "";
for (Object o : idn.getLinks()) {
  Link l = (Link) o;
  apps = apps + l.getApplicationName() + " | disabled=" + l.isDisabled() + "\n";
}

Rule r = context.getObjectByName(Rule.class, "AIG-Rule-IdentitySelector-Group-AH-UW-Platform-Okta-SSO");
Map args = new HashMap();
args.put("identity", idn);

return "YOUR ACCOUNTS:\n" + apps + "\nRULE RETURNS: " + context.runRule(r, args);
