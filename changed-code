public List getRoleListForPayload(List appRoleList) {
    List roleList = new ArrayList();
    if(null!=appRoleList && appRoleList.size()>0) {
        for(String eachEnt:appRoleList) {
            List paramList = Arrays.asList(eachEnt.split("\\|"));
            if(null!=paramList && paramList.size()==5) {
                Map eachRoleMap = new HashMap();
                eachRoleMap.put("roleId",paramList.get(3));
                eachRoleMap.put("roleName",paramList.get(4));
                roleList.add(eachRoleMap);
            }
        }
    }
    return roleList;
}
 
public Object getAttributeFromExistingLink(Identity identityObject, Application application, String nativeIdentity, String entAttr) {
    Object obj = null;
    IdentityService identityService = new IdentityService(context);
    List identityLinks = (List)identityService.getLinks(identityObject,application);
    if(null!=identityLinks && identityLinks.size()>0) {
        for(Link eachLink:identityLinks) {
            if(null!=eachLink.getNativeIdentity() && eachLink.getNativeIdentity().equalsIgnoreCase(nativeIdentity)) {
                obj = eachLink.getAttribute(entAttr);
                break;
            }
        }
    }
    return obj;
}
 
