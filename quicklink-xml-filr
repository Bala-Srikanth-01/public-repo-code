<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE DynamicScope PUBLIC "sailpoint.dtd" "sailpoint.dtd">
<DynamicScope name="Disable AD Accounts Population">
  <Selector>
    <IdentitySelector>
      <Script>
        <Source><![CDATA[
import sailpoint.object.Identity;
import java.util.List;

// Only members of this workgroup get the QuickLink
String WORKGROUP_NAME = "Disable AD Accounts Users";

if (identity == null) return false;
List wgs = identity.getWorkgroups();
if (wgs == null) return false;
for (int i = 0; i < wgs.size(); i++) {
    Identity wg = (Identity) wgs.get(i);
    if (wg != null && WORKGROUP_NAME.equals(wg.getName())) return true;
}
return false;
        ]]></Source>
      </Script>
    </IdentitySelector>
  </Selector>
  <QuickLinkOptions allowSelf="true">
    <QuickLinkRef>
      <Reference class="sailpoint.object.QuickLink" name="Disable AD Accounts"/>
    </QuickLinkRef>
  </QuickLinkOptions>
</DynamicScope>
