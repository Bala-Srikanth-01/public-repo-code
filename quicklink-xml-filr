import sailpoint.api.Terminator;
import sailpoint.object.*;

Identity idn = context.getObjectByName(Identity.class, "PUT_IDENTITY_NAME");
if (idn == null) { return "identity not found"; }

Link del = null;
for (Object o : idn.getLinks()) {
  Link link = (Link) o;
  if (link.getApplicationName().indexOf("UW Platform") >= 0) {
    del = link;
  }
}

if (del == null) { return "no socotra account"; }

String id = del.getNativeIdentity();
new Terminator(context).deleteObject(del);
context.commitTransaction();
return "deleted socotra account " + id;
